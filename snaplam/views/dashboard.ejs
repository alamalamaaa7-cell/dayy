<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SnapLam - Dashboard</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body data-theme="<%= user.theme || 'abu' %>" data-username="<%= user.username %>" data-role="<%= user.role %>">
<div class="blob blob1"></div>
<div class="blob blob2"></div>
<div class="toast-stack" id="toastStack"></div>

<div class="app-shell">
  <header class="topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="menuToggle" aria-label="Buka menu">
        <svg viewBox="0 0 24 24">
          <line class="bar bar-top" x1="4" y1="6" x2="20" y2="6"/>
          <line class="bar bar-mid" x1="4" y1="12" x2="20" y2="12"/>
          <line class="bar bar-bot" x1="4" y1="18" x2="20" y2="18"/>
        </svg>
      </button>
      <div class="brand-mini"><span class="dot"></span>SnapLam</div>
    </div>
    <div class="topbar-right">
      <span class="live-pill"><span class="pulse-dot"></span><span>Live</span></span>
      <div class="userchip-mini">
        <div class="avatar sm"><%= user.username.charAt(0).toUpperCase() %></div>
        <span class="uname"><%= user.username %></span>
      </div>
    </div>
  </header>

  <%- include('partials/sidebar', { user: user }) %>
  <%- include('partials/chatmodal') %>

  <main class="main">
    <div>
      <h1 class="page-title">Halo, <%= user.username %> 👋</h1>
      <div class="subtitle">Unduh video/audio dari berbagai platform favoritmu — cepat &amp; realtime.</div>
    </div>

    <div class="panel">
      <div class="section-title"><span class="bar"></span>Downloader</div>
      <form id="dlForm" class="dl-form">
        <div class="field-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.07 0l1.41-1.41a5 5 0 00-7.07-7.07L10 6"/><path d="M14 11a5 5 0 00-7.07 0L5.5 12.4a5 5 0 007.07 7.07L14 18"/></svg>
          <input type="url" id="dlUrl" placeholder="Tempel link TikTok / YouTube / Instagram / dll..." required>
        </div>
        <select id="dlRes">
          <option value="1080p">1080p</option>
          <option value="720p" selected>720p</option>
        </select>
        <button type="submit" id="dlBtn">
          <span class="spinner"></span>
          <svg class="lbl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span id="dlBtnLabel">Unduh Sekarang</span>
        </button>
      </form>

      <div class="progress-wrap" id="progressWrap">
        <div class="progress-track"><div class="progress-bar" id="progressBar"></div></div>
      </div>

      <div class="terminal-wrap">
        <div class="terminal-head">
          <span class="terminal-dot r"></span><span class="terminal-dot y"></span><span class="terminal-dot g"></span>
          <span class="terminal-label">log-aktivitas — live</span>
        </div>
        <div class="terminal" id="terminal"></div>
      </div>

      <div class="result-box" id="resultBox"></div>
    </div>

    <div class="panel">
      <div class="section-title"><span class="bar"></span>Riwayat Unduhan<span class="count"><%= history.length %></span></div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead>
            <tr><th>Platform</th><th>URL</th><th>Resolusi</th><th>Status</th><th>Hasil</th></tr>
          </thead>
          <tbody id="historyBody">
            <% if (history.length === 0) { %>
              <tr><td colspan="5" class="empty-state">Belum ada riwayat unduhan.</td></tr>
            <% } %>
            <% history.forEach(function(h) { %>
              <tr>
                <td><%= h.platform || '-' %></td>
                <td class="mono" style="max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= h.url %></td>
                <td><%= h.resolution || '-' %></td>
                <td><span class="badge <%= h.status === 'sukses' ? 'sukses' : 'gagal' %>"><%= h.status %></span></td>
                <td><% if (h.status === 'sukses' && h.result_url) { %><a href="<%= h.result_url %>" target="_blank" style="color:var(--accent2); font-weight:700;">Buka</a><% } else { %>-<% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <div class="section-title">
        <span class="bar"></span>Aktivitas Live Semua User
        <span class="terminal-live-badge"><span class="pulse-dot"></span>live</span>
        <span class="count" id="activityCount">0</span>
      </div>
      <div class="subtitle" style="margin:-6px 0 4px;">Setiap unduhan dari seluruh user muncul di sini secara realtime.</div>
      <div class="terminal-wrap">
        <div class="terminal-head">
          <span class="terminal-dot r"></span><span class="terminal-dot y"></span><span class="terminal-dot g"></span>
          <span class="terminal-label">global-activity — live</span>
        </div>
        <div class="terminal activity-terminal" id="globalTerminal"></div>
      </div>
    </div>

    <%- include('partials/footer') %>
  </main>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/theme.js"></script>
<script src="/js/ui.js"></script>
<script src="/js/chat.js"></script>
<script src="/js/activity.js"></script>
<script src="/js/dashboard.js"></script>
<script>SnapLamTheme.init('<%= user.theme || "abu" %>');</script>
</body>
</html>
